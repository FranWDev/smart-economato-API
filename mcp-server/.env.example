PORT=3000
SERVICE_KEY=change-me-in-production-minimum-32-chars
BACKEND_BASE_URL=https://your-backend-url.com

# (Optional) AI Provider registry configuration in JSON format.
# If not defined, defaults are used: OPENAI, DEEPSEEK, GROQ, ANTHROPIC.
# PROVIDER_REGISTRY={"OPENAI":{"type":"openai-compatible"},"DEEPSEEK":{"type":"openai-compatible","baseUrl":"https://api.deepseek.com"},"GROQ":{"type":"openai-compatible","baseUrl":"https://api.groq.com/openai/v1"},"ANTHROPIC":{"type":"anthropic"}}

# Inventory Client resilience configuration
INVENTORY_TIMEOUT_MS=10000
INVENTORY_MAX_RETRIES=3

# CORS configuration (comma-separated origins, or omit for allow-all in development)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

